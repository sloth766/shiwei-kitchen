    "minutes": 15,
    "servings": 2,
    "diet": "vegetarian",
    "image": "/assets/eggs.jpg",
    "image_alt": "鸡蛋与番茄早餐",
    "description": "酸甜番茄，柔软鸡蛋，是熟悉的家的味道。",
    "difficulty": "新手友好",
    "ingredients": [
      {
        "name": "番茄",
        "quantity": 400,
        "unit": "克"
      },
      {
        "name": "鸡蛋",
        "quantity": 3,
        "unit": "个"
      },
      {
